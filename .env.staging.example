# Staging: a copy of production for trying releases before they reach real books.
# Copy to .env on the staging server and fill in the empty values. Never point staging at the production database.

APP_NAME="KontoTrack (staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.staging.example.com

# The staging web app (kontotrack-fr built with VITE_API_BASE_URL set to APP_URL above).
KONTOTRACK_FRONTEND_URL=https://staging.example.com
CORS_ALLOWED_ORIGINS=https://staging.example.com
SANCTUM_STATEFUL_DOMAINS=staging.example.com
SESSION_DOMAIN=.staging.example.com
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kontotrack_staging
DB_USERNAME=kontotrack_staging
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Use a mail sandbox on staging so test emails never reach real customers.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=staging@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Different from production, so a staging backup can never be restored over production by mistake.
KONTOTRACK_BACKUP_PATH=
KONTOTRACK_BACKUP_KEEP=7
KONTOTRACK_BACKUP_PASSWORD=
KONTOTRACK_BLIND_INDEX_KEY=
